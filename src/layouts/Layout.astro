---
import { getImage } from "astro:assets";
import Menu from "../components/Menu.astro";
import { siteMetadata } from "../data/site";
import sunrise from "../images/sunrise-background01.jpg";
import "../styles/global.css";

interface Props {
	title?: string;
}

const { title = siteMetadata.title } = Astro.props;

const bg = await getImage({
	src: sunrise,
	format: "webp",
	quality: 75,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <title>{`${title} | ${siteMetadata.title}`}</title>
    <meta name="description" content={siteMetadata.description} />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={siteMetadata.description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:creator" content={siteMetadata.author} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={siteMetadata.description} />
    <meta name="theme-color" content="#decd87" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="manifest"
      href="/manifest.webmanifest"
      crossorigin="anonymous"
    />
    <link rel="apple-touch-icon" sizes="48x48" href="/icons/icon-48x48.png" />
    <link rel="apple-touch-icon" sizes="72x72" href="/icons/icon-72x72.png" />
    <link rel="apple-touch-icon" sizes="96x96" href="/icons/icon-96x96.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/icons/icon-144x144.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/icons/icon-192x192.png" />
    <link rel="apple-touch-icon" sizes="256x256" href="/icons/icon-256x256.png" />
    <link rel="apple-touch-icon" sizes="384x384" href="/icons/icon-384x384.png" />
    <link rel="apple-touch-icon" sizes="512x512" href="/icons/icon-512x512.png" />
    <link
      href="https://fonts.googleapis.com/css?family=Quintessential|Source+Sans+Pro:300,400,400i,700|Lora:400i"
      rel="stylesheet"
    />
  </head>
  <body>
    <section
      class="background"
      style={`background-image: url('${bg.src}')`}
    >
      <div class="container">
        <Menu />
        <main class="main" data-main>
          <slot />
        </main>
      </div>
    </section>
  </body>
</html>

<style>
  .background {
    background-color: lightgray;
    overflow: hidden;
    min-height: 100vh;
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    animation: fade-in 1.5s ease-in-out;
  }

  .container {
    display: grid;
    grid-template-columns: 20rem 1fr;
    grid-template-areas: 'main main';
  }

  .main {
    scroll-snap-type: y proximity;
    height: 100vh;
    overflow: auto;
    width: 100%;
    grid-area: main;
  }

  @media (min-width: 1400px) {
    .container {
      grid-template-areas: 'menu main';
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .background {
      animation: none;
    }
  }
</style>
