---
interface Props {
	title: string;
	link: string;
	image: string;
	alt: string;
}
const { title, link, image, alt } = Astro.props;
---

<div class="card">
  <a href={link} target="_blank" rel="noopener noreferrer" title={title}>
    <img src={image} alt={alt} title={title} />
  </a>
  <h3>{title}</h3>
</div>

<style>
  .card {
    margin: 1rem;
    padding: 1rem 1rem 0 1rem;
    background: white;
    border-radius: 0.2rem;
    box-shadow: 0px 0px 89px -17px rgba(0, 0, 0, 0.5);
    transition: all 0.2s ease-in-out;
    will-change: transform;
  }

  .card:hover {
    box-shadow: 0px 0px 89px -17px rgba(0, 0, 0, 0.75);
    transform: translate3d(0, -5px, 0) scale(1.01);
  }

  .card img {
    width: 100%;
    height: auto;
  }

  .card h3 {
    text-align: center;
    margin: 0;
    padding: 1rem;
  }
</style>
