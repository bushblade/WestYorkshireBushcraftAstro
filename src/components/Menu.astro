---
import { links } from "../data/site";

const navLinks = [
	{ to: "About", target: "about" },
	{ to: "Galleries", target: "galleries" },
	{ to: "Contact", target: "contact" },
];
---

<button
  type="button"
  class="menu-button"
  data-menu-button
  aria-label="Toggle menu"
  aria-expanded="false"
  aria-controls="site-menu"
>
  <span></span>
</button>
<nav class="menu" id="site-menu" data-menu aria-label="Main">
  <ul class="nav-links">
    {navLinks.map(({ to, target }) => (
      <li>
        <button type="button" data-nav-link={target}>{to}</button>
      </li>
    ))}
  </ul>
  <h2 class="menu-title">Connect with WYB</h2>
  <ul class="social-links">
    <li>
      <a
        href={links.facebook}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Facebook (opens in a new tab)"
      >
        <i class="lab la-facebook la-lg"></i> Facebook
      </a>
    </li>
    <li>
      <a
        href={links.youtube}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="YouTube (opens in a new tab)"
      >
        <i class="lab la-youtube la-lg"></i> YouTube
      </a>
    </li>
    <li>
      <a
        href={links.email}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Email us (opens in a new tab)"
      >
        <i class="las la-envelope la-lg"></i> Email us
      </a>
    </li>
  </ul>
</nav>

<style>
  .menu {
    position: fixed;
    top: 0;
    left: 0;
    height: 100vh;
    width: 50vw;
    z-index: 10;
    box-shadow: 0px 0px 36px 0px rgba(0, 0, 0, 0.35);
    padding: 10rem 0;
    background: linear-gradient(
      45deg,
      var(--darkGrey) 0%,
      var(--lightGrey) 100%
    );
  }

  .menu .menu-title {
    font-family: 'Quintessential', cursive;
    font-weight: 400;
    font-size: 1.5rem;
    color: var(--white);
    text-align: center;
    margin-top: 5rem;
    background: none;
    white-space: normal;
  }

  .menu ul {
    list-style: none;
    color: var(--white);
    margin: auto;
    font-size: 2.5rem;
    width: 100%;
    text-align: center;
    line-height: 4rem;
    padding: 0;
  }

  .menu ul li {
    transition: all 0.2s ease-in-out;
  }

  .menu ul li:hover {
    transform: scale(1.05);
  }

  .menu ul button,
  .menu ul a {
    cursor: pointer;
    background: none;
    font-size: inherit;
    border: none;
    color: var(--white);
    font-family: 'Lora', serif;
    box-shadow: none;
  }

  .menu ul button:focus-visible,
  .menu ul a:focus-visible {
    outline: 2px solid var(--white);
    outline-offset: 2px;
  }

  .menu-button:focus-visible {
    outline: 2px solid black;
    outline-offset: 2px;
  }

  .menu-button {
    appearance: none;
    -webkit-appearance: none;
    background: transparent;
    border: none;
    padding: 0;
    position: fixed;
    top: 1rem;
    left: 1.5rem;
    z-index: 12;
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    cursor: pointer;
    margin: 0 auto;
    transition: all 0.3s;
  }

  .menu-button span {
    position: absolute;
    top: 50%;
    display: block;
    width: 100%;
    height: 0.3rem;
    background-color: rgb(51, 51, 51);
    border-radius: 3px;
  }

  .menu-button span::before,
  .menu-button span::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(51, 51, 51);
    border-radius: 3px;
    transition: all 0.3s;
  }

  .menu-button span::before {
    transform: translateY(-0.7rem);
  }

  .menu-button span::after {
    transform: translateY(0.7rem);
  }

  .menu-button[data-open='true'] {
    transform: rotate(45deg);
  }

  .menu-button[data-open='true'] span,
  .menu-button[data-open='true'] span::before,
  .menu-button[data-open='true'] span::after {
    background-color: whitesmoke;
    transform: rotate(90deg);
  }

  @media (min-width: 1400px) {
    .menu {
      position: static;
      width: 100%;
      grid-area: menu;
    }
    .menu-button {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .menu {
      width: 80vw;
    }
  }
</style>

<script>
  import '../scripts/menu'
</script>
