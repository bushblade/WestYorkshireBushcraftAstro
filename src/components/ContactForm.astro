    cursor: not-allowed;
  }

  .message-success {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .message-success[hidden] {
    display: none;
  }

  .message-success .main {
    padding: 1rem 1rem 0 1rem;
    border-radius: 0.5rem;
    border: 0.2rem solid var(--darkGrey);
    box-shadow: 0px 0px 89px -17px rgba(0, 0, 0, 0.5);
    background: var(--lowOpacityWhite);
