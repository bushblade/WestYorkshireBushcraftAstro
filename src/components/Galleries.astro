---
import { getImage } from "astro:assets";
import { links } from "../data/site";
import campcraft from "../images/camp&craft.jpg";
import floraforage from "../images/flora&forage.jpg";
import sitescenery from "../images/sites&scenery.jpg";
import tracktrail from "../images/track&trail.jpg";
import Card from "./Card.astro";

const images = [
	await getImage({ src: campcraft, width: 600, quality: 75 }),
	await getImage({ src: tracktrail, width: 600, quality: 75 }),
	await getImage({ src: floraforage, width: 600, quality: 75 }),
	await getImage({ src: sitescenery, width: 600, quality: 75 }),
];

const cards = [
	{ title: "Camp & Craft", link: links.galleries.campcraft, image: 0 },
	{ title: "Track & Trail", link: links.galleries.tracktrail, image: 1 },
	{
		title: "Flora, Fungi & Forage",
		link: links.galleries.floraforage,
		image: 2,
	},
	{ title: "Sites & Scenery", link: links.galleries.sitescenery, image: 3 },
];
---

<div class="heading">
  <h2>Members Galleries</h2>
  <p>
    The images in the galleries have been taken by our members while in
    attendance of meets,
    <br /> they are usually updated after each meet so if you're interested in
    what we get up to, please have a look.
  </p>
</div>

<div class="grid">
  <div class="cell left">
    <Card
      title={cards[0].title}
      link={cards[0].link}
      image={images[cards[0].image].src}
      alt={`${cards[0].title} gallery`}
    />
  </div>
  <div class="cell right">
    <Card
      title={cards[1].title}
      link={cards[1].link}
      image={images[cards[1].image].src}
      alt={`${cards[1].title} gallery`}
    />
  </div>
</div>

<div class="grid">
  <div class="cell left">
    <Card
      title={cards[2].title}
      link={cards[2].link}
      image={images[cards[2].image].src}
      alt={`${cards[2].title} gallery`}
    />
  </div>
  <div class="cell right">
    <Card
      title={cards[3].title}
      link={cards[3].link}
      image={images[cards[3].image].src}
      alt={`${cards[3].title} gallery`}
    />
  </div>
</div>

<style>
  .heading {
    width: 100%;
    height: 100%;
    padding: 0 2rem 1rem 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      'left'
      'right';
    gap: 0;
    width: 100%;
    padding: 0 0.5rem;
  }

  .cell {
    display: flex;
    flex-direction: column;
    justify-content: space-around;
  }

  .cell.left {
    grid-area: left;
  }

  .cell.right {
    grid-area: right;
  }

  @media (min-width: 1000px) {
    .heading {
      padding: 0 3rem 1rem 3rem;
    }
    .grid {
      grid-template-columns: 1fr 1fr;
      grid-template-areas: 'left right';
      padding: 0 2rem;
    }
  }
</style>
