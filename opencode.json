{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "permission": {
    "bash": {
      "*": "ask",
      "pnpm *": "allow",
      "rm *": "ask",
      "grep *": "allow"
    },
    "edit": "ask",
    "webfetch": "allow",
    "read": "allow"
  },
  "formatter": {
    "biome": { "enabled": true }
  },
  "mcp": {
    "Astro docs": {
      "type": "remote",
      "url": "https://mcp.docs.astro.build/mcp",
      "enabled": true
    }
  }
}
